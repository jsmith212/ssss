<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ssss"
        Arguments=""
        InstallLocation="C:\Program Files\ssss\ssss">
    </Installer>
    <PackageInformation
        PackageName="ssss"
        PackageDisplayName="ssss"
        PublisherName="CN=ssss"
        PublisherDisplayName="ssss"
        Version="0.1.0.0"
        PackageDescription="Super Simple Sample Station">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ssss.app"
                Description="Super Simple Sample Station"
                DisplayName="ssss"
                ExecutableName="ssss"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ssss</DisplayName>
            <PublisherDisplayName>ssss</PublisherDisplayName>
            <Description>Super Simple Sample Station</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ssss.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
